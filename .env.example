# Copia este archivo como .env únicamente en el servidor. Nunca lo subas a Git.
# PostgreSQL recomendado para producción; usa una cuenta con permisos limitados.
BLUE_POS_DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@HOST:5432/puntos_eccos
BLUE_POS_AUTH_DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@HOST:5432/puntos_eccos_auth

# Se usan sólo al crear el primer administrador.
BLUE_POS_ADMIN_USER=administrador
BLUE_POS_ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_LARGA
BLUE_POS_RECOVERY_CODE=GUARDA_ESTE_CODIGO_FUERA_DEL_SERVIDOR

# No actives esto en producción: borra una vez los datos operativos de demostración.
BLUE_POS_DEMO_RESET=false
